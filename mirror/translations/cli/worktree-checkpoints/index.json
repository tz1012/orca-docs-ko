    },
    "/docs/cli/worktree-checkpoints/:paragraph:reading-before-writing:0": {
      "sourceHash": "240123735cfdfeebc6cf52c5817c19613f1830021cfdc2e29cce09e776a07f26",
      "translated": "댓글에 사용자가 작성한 컨텍스트가 있을 수 있는 경우 먼저 읽어 목표나 제약 조건을 방해하지 않도록 하세요."
    },
    "/docs/cli/worktree-checkpoints/:code:reading-before-writing:0": {
      "sourceHash": "26e69199c2622c8fd5d954c7e80c640916e20c2374cf2f6b50910c69602388fe",
      "translated": "````\nORCA_PROTECTED_0001\n````"
    },
