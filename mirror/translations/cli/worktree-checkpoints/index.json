      "sourceHash": "e834cf1e8b5dc917e4de3cd81de828c32331d6753c2397cde67a6b5576a3dae6",
      "translated": "````\nORCA_PROTECTED_0001\n````"
    },
    "/docs/cli/worktree-checkpoints/:heading:good-checkpoint-moments:0": {
